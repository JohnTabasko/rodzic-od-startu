NODE_ENV=development
PORT=3000
# Optional directory for local JSON/community/log runtime files.
# DATA_DIR=/var/lib/rodzic-od-startu

# Required in production; use a random value of at least 32 characters.
JWT_SECRET=replace-with-a-random-secret-of-at-least-32-characters

# Required in production. Leave unset for the local JSON development store.
# DATABASE_URL=postgres://postgres:dev@localhost:5432/rodzic

# Comma-separated origins. Required in production.
# CORS_ORIGIN=https://app.example.com

# Optional integrations
# ADMIN_TOKEN=replace-with-a-long-random-token
# OPENAI_API_KEY=sk-...
# GOOGLE_CLIENT_IDS=your-google-client-id.apps.googleusercontent.com
# APPLE_CLIENT_ID=pl.example.app
# SOCIAL_DEV_MODE=false
