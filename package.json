{
  "name": "rodzic-od-startu",
  "version": "0.1.0",
  "main": "node_modules/expo/AppEntry.js",
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "typecheck": "tsc --noEmit",
    "backend:typecheck": "npm --prefix backend run typecheck",
    "backend:build": "npm --prefix backend run build",
    "backend:test": "npm --prefix backend test",
    "format": "prettier --write \"App.tsx\" \"src/**/*.{ts,tsx}\" \"backend/src/**/*.ts\" \"backend/tests/**/*.ts\" \"*.json\" \"backend/*.json\" \"*.md\" \"backend/*.md\"",
    "format:check": "prettier --check \"App.tsx\" \"src/**/*.{ts,tsx}\" \"backend/src/**/*.ts\" \"*.json\" \"backend/*.json\" \"backend/tests/**/*.ts\" \"*.md\" \"backend/*.md\"",
    "verify": "npm run typecheck && npm run backend:typecheck && npm run backend:test && npm run format:check"
  },
  "dependencies": {
    "@expo/metro-runtime": "~57.0.8",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-navigation/bottom-tabs": "^7.2.0",
    "@react-navigation/native": "^7.0.14",
    "@react-navigation/native-stack": "^7.2.0",
    "expo": "~57.0.11",
    "expo-asset": "~57.0.9",
    "expo-file-system": "~57.0.2",
    "expo-notifications": "~57.0.9",
    "expo-secure-store": "~57.0.1",
    "expo-sharing": "~57.0.10",
    "expo-video": "~57.0.2",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.2",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-web": "^0.21.2",
    "zustand": "^5.0.2"
  },
  "devDependencies": {
    "@babel/core": "^7.26.0",
    "@types/react": "~19.2.4",
    "prettier": "3.6.2",
    "typescript": "~6.0.3"
  },
  "overrides": {
    "uuid": "^11.1.1"
  },
  "private": true
}
